// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ApplicationStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(USER)
  balance      Int      @default(0)
  totalRecharge Int     @default(0)
  lastOnlineAt DateTime?
  active       Boolean  @default(true)
  invited      Boolean  @default(false)
  invitedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications Application[]
  applicationOrders ApplicationOrder[]
  invitedBy    User?    @relation("UserInvites", fields: [invitedById], references: [id])
  invitees     User[]   @relation("UserInvites")

  @@index([invitedById])
}

model SiteSettings {
  id           Int      @id @default(1)
  siteName     String   @default("周末病历系统")
  smtpHost     String   @default("")
  smtpPort     Int      @default(587)
  smtpUser     String   @default("")
  smtpPassword String   @default("")
  smtpFrom     String   @default("")
  inviteEnabled Boolean  @default(true)
  inviteCost   Int      @default(0)
  watermarkText String  @default("")
  watermarkOpacity Float @default(0.16)
  watermarkFontSize Int @default(18)
  watermarkColor String @default("#64748b")
  updatedAt    DateTime @updatedAt
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email])
}

model Application {
  id          String            @id @default(cuid())
  name        String
  description String            @db.Text
  coverUrl    String?           @db.LongText
  category    String            @default("病历")
  price       Int               @default(0)
  status      ApplicationStatus @default(DRAFT)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  fields      ApplicationField[]
  orders      ApplicationOrder[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([createdById])
}

model ApplicationField {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldKey      String
  description   String
  type          String      @default("text")
  required      Boolean     @default(false)
  config        Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, fieldKey])
  @@index([applicationId])
}

model ApplicationOrder {
  id            String      @id @default(cuid())
  applicationId String
  userId        String
    price         Int
    balanceBefore Int?
    balanceAfter  Int?
    imageKey      String?
    imageContentType String?
    imageUploadedAt DateTime?
    imageExpiresAt DateTime?
  status        String      @default("CREATED")
  content       Json?
  application   Application @relation(fields: [applicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([userId])
}
